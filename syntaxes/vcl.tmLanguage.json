{
    "name": "VCL",
    "scopeName": "source.vcl",
    "fileTypes": [
        "vcl"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.vcl",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.vcl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.vcl",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.vcl",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.vcl",
                    "match": "\\b\\d+(\\.\\d+)?[smhd]?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.vcl",
                    "match": "\\b(vcl|import|include|if|else|elsif|return|call|new|set|unset|remove|ban|purge|hash_data|regsub|regsuball)\\b"
                },
                {
                    "name": "storage.type.vcl",
                    "match": "\\b(backend|probe|acl|sub|director)\\b"
                },
                {
                    "name": "constant.language.vcl",
                    "match": "\\b(pass|pipe|hit|miss|fetch|deliver|error|restart|lookup|ok|fail|healthy|sick|grace|keep)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.vcl",
                    "match": "\\b(vcl_recv|vcl_pipe|vcl_pass|vcl_hit|vcl_miss|vcl_fetch|vcl_deliver|vcl_error|vcl_init|vcl_fini|vcl_hash|vcl_backend_fetch|vcl_backend_response|vcl_backend_error|vcl_synth)\\b"
                },
                {
                    "name": "support.function.vcl",
                    "match": "\\b(std\\.|bereq\\.|beresp\\.|req\\.|resp\\.|obj\\.|client\\.|server\\.|now|hash_data|regsub|regsuball)\\w*"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.readwrite.vcl",
                    "match": "\\b(req|bereq|beresp|resp|obj|client|server|storage)\\.[a-zA-Z_][a-zA-Z0-9_.-]*"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.vcl",
                    "match": "(==|!=|~|!~|&&|\\|\\||!|=|\\+|\\-|\\*|/|%|<|>|<=|>=)"
                }
            ]
        }
    }
}